@model ASP_BeachBar.Data.Product

@{
    ViewData["Title"] = "Изтриване";
}

<div class="section-head"><div><p class="eyebrow">Меню</p><h1>Изтриване на продукт</h1></div></div>

<h3 class="danger-note">Сигурен ли си, че искаш да изтриеш този запис?</h3>
<div class="detail-card">
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Име
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            Категория
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Categories.Name)
        </dd>
        <dt class = "col-sm-2">
            Снимка
        </dt>
        <dd class = "col-sm-10">
            <img class="thumb" src="@Model.ImageUrl" alt="@Model.Name" />
        </dd>
        <dt class = "col-sm-2">
            Описание
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            Грамаж
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Weight)
        </dd>
        <dt class = "col-sm-2">
            Цена
        </dt>
        <dd class = "col-sm-10">
            @Model.Price.ToString("0.00") €
        </dd>
        <dt class = "col-sm-2">
            Добавен на
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RegisterOn)
        </dd>
    </dl>
    
    <form asp-action="Delete" class="detail-actions">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Изтрий" class="btn btn-danger" />
        <a asp-action="Index">Назад към храната</a>
    </form>
</div>
