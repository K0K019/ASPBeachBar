@model IEnumerable<ASP_BeachBar.Data.Product>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Име на продукта
@* 
                @Html.DisplayNameFor(model => model.Name) *@
            </th>
            <th>
                Категория

               @*  @Html.DisplayNameFor(model => model.Categories) *@
            </th>
            <th>

                Снимка на продукта
                @* @Html.DisplayNameFor(model => model.ImageUrl) *@
            </th>
            <th>
                Описание
               @*  @Html.DisplayNameFor(model => model.Description) *@
            </th>
            <th>
                Грамаж
                @* @Html.DisplayNameFor(model => model.Weight) *@
            </th>
            <th>
                Цена
                @* @Html.DisplayNameFor(model => model.Price) *@
            </th>
            <th>
                Дата на регистрация
                @* @Html.DisplayNameFor(model => model.RegisterOn) *@
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Categories.Name)
            </td>
            <td>
                <img src="@item.ImageUrl" alt="@item.Name" width="100px" height="145px"/>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Weight)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Price)€
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RegisterOn)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
