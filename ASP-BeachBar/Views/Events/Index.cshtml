@model IEnumerable<ASP_BeachBar.Data.Event>

@{
    ViewData["Title"] = "Събития";
}

<div class="section-head">
    <div>
        <p class="eyebrow">Календар</p>
        <h1>Събития край морето</h1>
        <p>Залези с музика, акустични вечери и тематични брънчове с места за резервация.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-beach" asp-action="Create">Добави събитие</a>
    }
</div>

<div class="event-grid">
@foreach (var item in Model)
{
    <article class="beach-card">
        <img class="card-img" src="@item.ImageUrl" alt="@item.Name" />
        <div class="beach-card-body">
            <div class="card-title-row">
                <h2>@item.Name</h2>
                <span class="price-pill">@item.DateReservation.ToString("dd MMM")</span>
            </div>
            <p class="muted mt-2">@item.Description</p>
            <span class="meta-pill">@item.DateReservation.ToString("HH:mm") ч.</span>
            <div class="card-actions">
                @if (item.DateReservation >= DateTime.Now)
                {
                    <a class="btn btn-sm btn-beach" asp-controller="Reservations" asp-action="Create" asp-route-eventId="@item.Id">Резервирай</a>
                }
                <a class="btn btn-sm btn-outline-beach" asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-sm btn-outline-beach" asp-action="Edit" asp-route-id="@item.Id">Редакция</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Изтриване</a>
                }
            </div>
        </div>
    </article>
}
</div>
