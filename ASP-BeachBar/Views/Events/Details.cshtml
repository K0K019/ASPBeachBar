@model ASP_BeachBar.Data.Event

@{
    ViewData["Title"] = "Детайли";
}

<div class="section-head"><div><p class="eyebrow">Календар</p><h1>Детайли за събитие</h1></div></div>

<div class="detail-card">
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Име
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            Снимка
        </dt>
        <dd class = "col-sm-10">
            <img class="thumb" src="@Model.ImageUrl" alt="@Model.Name" />
        </dd>
        <dt class = "col-sm-2">
            Описание
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dt class = "col-sm-2">
            Дата и час
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DateReservation)
        </dd>
        <dt class = "col-sm-2">
            Добавено на
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RegisterOn)
        </dd>
        <dt class = "col-sm-2">
            Последна актуализация
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.LastUpdatedOn)
        </dd>
    </dl>
</div>
<div class="detail-actions">
    @if (Model.DateReservation >= DateTime.Now)
    {
        <a class="btn btn-beach" asp-controller="Reservations" asp-action="Create" asp-route-eventId="@Model.Id">Резервирай</a>
    }
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-outline-beach" asp-action="Edit" asp-route-id="@Model?.Id">Редакция</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model?.Id">Изтриване</a>
    }
    <a asp-action="Index">Назад към събитията</a>
</div>
