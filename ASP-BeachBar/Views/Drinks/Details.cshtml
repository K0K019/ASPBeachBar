@model ASP_BeachBar.Data.Drink

@{
    ViewData["Title"] = "Детайли";
}

<div class="section-head"><div><p class="eyebrow">Бар</p><h1>Детайли за напитка</h1></div></div>

<div class="detail-card">
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Име
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            Снимка
        </dt>
        <dd class = "col-sm-10">
            <img class="thumb" src="@Model.ImageUrl" alt="@Model.Name" />
        </dd>
        <dt class = "col-sm-2">
            Тип
        </dt>
        <dd class = "col-sm-10">
            @(Model.IsAlcoholic ? "Алкохолна" : "Без алкохол")
        </dd>
        <dt class = "col-sm-2">
            Категория
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Categories.Name)
        </dd>
        <dt class = "col-sm-2">
            Количество
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Weight)
        </dd>
        <dt class = "col-sm-2">
            Цена
        </dt>
        <dd class = "col-sm-10">
            @Model.Price.ToString("0.00") €
        </dd>
        <dt class = "col-sm-2">
            Добавена на
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.RegisterOn)
        </dd>
    </dl>
</div>
<div class="detail-actions">
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-outline-beach" asp-action="Edit" asp-route-id="@Model?.Id">Редакция</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model?.Id">Изтриване</a>
    }
    <a asp-action="Index">Назад към напитките</a>
</div>
