@model IEnumerable<ASP_BeachBar.Data.Drink>

@{
    ViewData["Title"] = "Напитки";
}

<div class="section-head">
    <div>
        <p class="eyebrow">Бар</p>
        <h1>Студени напитки</h1>
        <p>Коктейли, лимонади и свежи миксове за целия ден.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-beach" asp-action="Create">Добави напитка</a>
    }
</div>

<div class="menu-grid">
@foreach (var item in Model)
{
    <article class="beach-card">
        <img class="card-img" src="@item.ImageUrl" alt="@item.Name" />
        <div class="beach-card-body">
            <div class="card-title-row">
                <h2>@item.Name</h2>
                <span class="price-pill">@item.Price.ToString("0.00") €</span>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <span class="meta-pill">@(item.Categories?.Name ?? "Бар")</span>
                <span class="meta-pill">@item.Weight.ToString("0") мл</span>
                <span class="meta-pill">@(item.IsAlcoholic ? "Алкохолна" : "Без алкохол")</span>
            </div>
            <div class="card-actions">
                <a class="btn btn-sm btn-outline-beach" asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-sm btn-outline-beach" asp-action="Edit" asp-route-id="@item.Id">Редакция</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Изтриване</a>
                }
            </div>
        </div>
    </article>
}
</div>
