@model IEnumerable<ASP_BeachBar.Data.Category>

@{
    ViewData["Title"] = "Категории";
}

<div class="section-head">
    <div>
        <p class="eyebrow">Организация</p>
        <h1>Категории</h1>
        <p>Групите, по които менюто на бара се подрежда за гостите.</p>
    </div>
    <a class="btn btn-beach" asp-action="Create">Добави категория</a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th>Име</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td class="table-actions">
                    <a class="btn btn-sm btn-outline-beach" asp-action="Edit" asp-route-id="@item.Id">Редакция</a>
                    <a class="btn btn-sm btn-outline-beach" asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Изтриване</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
