@model ASP_BeachBar.Data.Category

@{
    ViewData["Title"] = "Детайли";
}

<div class="section-head"><div><p class="eyebrow">Организация</p><h1>Детайли за категория</h1></div></div>

<div class="detail-card">
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Име
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
</div>
<div class="detail-actions">
    <a class="btn btn-outline-beach" asp-action="Edit" asp-route-id="@Model?.Id">Редакция</a>
    <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model?.Id">Изтриване</a>
    <a asp-action="Index">Назад към категориите</a>
</div>
