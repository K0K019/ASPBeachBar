@model ASP_BeachBar.Data.Category

@{
    ViewData["Title"] = "Изтриване";
}

<div class="section-head"><div><p class="eyebrow">Организация</p><h1>Изтриване на категория</h1></div></div>

<h3 class="danger-note">Сигурен ли си, че искаш да изтриеш този запис?</h3>
<div class="detail-card">
    <h4>@Model.Name</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Име
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
    
    <form asp-action="Delete" class="detail-actions">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Изтрий" class="btn btn-danger" />
        <a asp-action="Index">Назад към категориите</a>
    </form>
</div>
