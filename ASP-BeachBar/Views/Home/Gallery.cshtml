@{
    ViewData["Title"] = "Галерия";
}

<section class="gallery-story">
    <div class="gallery-story-copy">
        <p class="eyebrow">Shoreline моменти</p>
        <h1>Галерия</h1>
        <p>Кадри от бара, морето, храната и вечерите, в които залезът държи светлината още малко.</p>
    </div>
    <div class="gallery-story-stack" aria-label="Акценти от галерията">
        <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1200&q=80" alt="Море и плаж" />
        <img src="https://images.unsplash.com/photo-1544145945-f90425340c7e?auto=format&fit=crop&w=900&q=80" alt="Коктейли на бара" />
        <img src="https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=900&q=80" alt="Вечер с музика" />
    </div>
</section>

<section class="gallery-collage" aria-label="Снимки от Shoreline Beach Bar">
    <figure class="gallery-card gallery-card-feature">
        <img src="https://images.unsplash.com/photo-1519046904884-53103b34b206?auto=format&fit=crop&w=1200&q=80" alt="Маса на плажа" />
        <figcaption>
            <span>01</span>
            <strong>Маси за дълги летни вечери</strong>
        </figcaption>
    </figure>

    <figure class="gallery-card">
        <img src="https://images.unsplash.com/photo-1551538827-9c037cb4f32a?auto=format&fit=crop&w=900&q=80" alt="Мохито" />
        <figcaption><span>02</span><strong>Коктейли</strong></figcaption>
    </figure>

    <figure class="gallery-card gallery-card-tall">
        <img src="https://cdn.pixabay.com/photo/2021/07/10/16/27/sea-6401823_1280.jpg" alt="Созопол край морето" />
        <figcaption><span>03</span><strong>Созопол</strong></figcaption>
    </figure>

    <figure class="gallery-card">
        <img src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38?auto=format&fit=crop&w=900&q=80" alt="Лятна храна" />
        <figcaption><span>04</span><strong>Меню за споделяне</strong></figcaption>
    </figure>

    <figure class="gallery-card gallery-card-wide">
        <img src="https://images.unsplash.com/photo-1516280440614-37939bbacd81?auto=format&fit=crop&w=1200&q=80" alt="Акустична вечер" />
        <figcaption><span>05</span><strong>Акустични вечери</strong></figcaption>
    </figure>

    <figure class="gallery-card">
        <img src="https://images.unsplash.com/photo-1621263764928-df1444c5e859?auto=format&fit=crop&w=900&q=80" alt="Лимонада" />
        <figcaption><span>06</span><strong>Лимонади</strong></figcaption>
    </figure>

    <figure class="gallery-card gallery-card-wide">
        <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&w=1200&q=80" alt="Храна и напитки" />
        <figcaption><span>07</span><strong>Неделен брънч</strong></figcaption>
    </figure>
</section>
