@model ASP_BeachBar.Data.Reservation

@{
    ViewData["Title"] = "Детайли";
}

<div class="section-head"><div><p class="eyebrow">Гости</p><h1>Детайли за резервация</h1></div></div>

<div class="detail-card">
    <h4>Резервация</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Клиент
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Clients.UserName)
        </dd>
        <dt class = "col-sm-2">
            Събитие
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Events.Name)
        </dd>
        <dt class = "col-sm-2">
            Места
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Count)
        </dd>
        <dt class = "col-sm-2">
            Резервирано на
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReservationDate)
        </dd>
        <dt class = "col-sm-2">
            Статус
        </dt>
        <dd class = "col-sm-10">
            @(Model.Status == ASP_BeachBar.Data.ReservationStatus.Cancelled ? "Анулирана" : "Активна")
        </dd>
    </dl>
</div>
<div class="detail-actions">
    <a class="btn btn-outline-beach" asp-action="Edit" asp-route-id="@Model?.Id">Редакция</a>
    @if (Model!.Status == ASP_BeachBar.Data.ReservationStatus.Active)
    {
        <form asp-action="Cancel" asp-route-id="@Model!.Id" method="post" class="d-inline p-0 m-0 border-0 bg-transparent shadow-none">
            <button type="submit" class="btn btn-outline-danger">Анулирай</button>
        </form>
    }
    @if (User.IsInRole("Admin"))
    {
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model?.Id">Изтриване</a>
    }
    <a asp-action="Index">Назад към резервациите</a>
</div>
