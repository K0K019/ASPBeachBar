@model ASP_BeachBar.Data.Reservation

@{
    ViewData["Title"] = "Изтриване";
}

<div class="section-head"><div><p class="eyebrow">Гости</p><h1>Изтриване на резервация</h1></div></div>

<h3 class="danger-note">Сигурен ли си, че искаш да изтриеш този запис?</h3>
<div class="detail-card">
    <h4>Резервация</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Клиент
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Clients.UserName)
        </dd>
        <dt class = "col-sm-2">
            Събитие
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Events.Name)
        </dd>
        <dt class = "col-sm-2">
            Места
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Count)
        </dd>
        <dt class = "col-sm-2">
            Резервирано на
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ReservationDate)
        </dd>
    </dl>
    
    <form asp-action="Delete" class="detail-actions">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Изтрий" class="btn btn-danger" />
        <a asp-action="Index">Назад към резервациите</a>
    </form>
</div>
