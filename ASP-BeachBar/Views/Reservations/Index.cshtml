@model IEnumerable<ASP_BeachBar.Data.Reservation>

@{
    ViewData["Title"] = "Резервации";
}

<div class="section-head">
    <div>
        <p class="eyebrow">Гости</p>
        <h1>Резервации</h1>
        <p>Запазени места за събитията в Shoreline Beach Bar.</p>
    </div>
    <a class="btn btn-beach" asp-action="Create">Нова резервация</a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th>Клиент</th>
                <th>Събитие</th>
                <th>Места</th>
                <th>Дата</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@(item.Clients?.UserName ?? item.ClientId)</td>
                <td>@(item.Events?.Name ?? "Събитие")</td>
                <td>@Html.DisplayFor(modelItem => item.Count)</td>
                <td>@item.ReservationDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td class="table-actions">
                    <a class="btn btn-sm btn-outline-beach" asp-action="Edit" asp-route-id="@item.Id">Редакция</a>
                    <a class="btn btn-sm btn-outline-beach" asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Изтриване</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
