@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<div class="section-head">
    <div>
        <p class="eyebrow">Системно съобщение</p>
        <h1>Нещо се обърка</h1>
        <p>Заявката не може да бъде обработена в момента. Опитай отново след малко.</p>
    </div>
</div>

<div class="danger-note">
    При повторна поява на проблема свържи се с администратора на Shoreline Beach Bar.
    @if (Model.ShowRequestId)
    {
        <span>Код: <code>@Model.RequestId</code></span>
    }
</div>
